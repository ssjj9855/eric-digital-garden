---
const {  
  title = "Eric Digital Garden", 
  description = "Eric Digital Garden - AI、科技、工具和个人探索记录" 
} = Astro.props; 
const currentPath = Astro.url.pathname;
---


<html lang="zh-CN">


<head>

<meta charset="UTF-8" />
<meta name="google-site-verification" content="MfYdgXP80lYcq0S4-9K3s08pxBvPNpnLh8eKnzPR5yA" />
<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{title}
</title>


<meta 
name="description" 
content={description}
/>


<link
rel="canonical"
href={`https://eric-digital-garden.vercel.app${Astro.url.pathname}`}
/>


<meta 
name="keywords" 
content="AI,人工智能,科技,工具,数字花园,效率"
/>


<meta 
name="author" 
content="Eric"
/>

<meta 
name="robots" 
content="index, follow"
/>

<meta 
property="og:title" 
content={title}
/>


<meta 
property="og:description" 
content={description}
/>


<meta 
property="og:type" 
content="website"
/>
<meta 
property="og:url" 
content={`https://eric-digital-garden.vercel.app${Astro.url.pathname}`}
/>

<meta 
property="og:site_name" 
content="Eric Digital Garden"
/>
<meta 
property="og:image" 
content="https://eric-digital-garden.vercel.app/og-image.png"
/>


<meta 
property="og:image:width" 
content="1200"
/>


<meta 
property="og:image:height" 
content="630"
/>


<meta 
name="twitter:image" 
content="https://eric-digital-garden.vercel.app/og-image.png"
/>

<meta 
name="twitter:card" 
content="summary_large_image"
/>


<meta 
name="twitter:title" 
content={title}
/>


<meta 
name="twitter:description" 
content={description}
/>


<link rel="icon" href="/favicon.svg" />


</head>




<body>

<div id="progress-bar"></div>

<button id="back-top">
↑
</button>

<header>


<div class="logo">


<a href="/">
Eric
</a>


</div>





<nav>


<a
href="/"
class={currentPath === "/" ? "active" : ""}
>
Home
</a>


<a 
href="/blog"
class={currentPath.startsWith("/blog") ? "active" : ""}
>
Blog
</a>


<a
href="/categories"
class={currentPath.startsWith("/categories") ? "active" : ""}
>
Categories
</a>


<a
href="/projects"
class={currentPath === "/projects" ? "active" : ""}
>
Projects
</a>


<a
href="/about"
class={currentPath === "/about" ? "active" : ""}
>
About
</a>

<a href="/search">
🔍 Search
</a>

<button id="theme-toggle">
🌙
</button>


</nav>



</header>





<main data-pagefind-body>

<slot />

</main>





<footer>

<p>
© 2026 Eric Digital Garden
</p>

<p>
Built with Astro · Markdown · AI
</p>

<p>
探索技术，记录成长。
</p>

</footer>





<script>


const button = document.getElementById("theme-toggle");


const currentTheme = localStorage.getItem("theme");


if(currentTheme === "dark"){

document.documentElement.classList.add("dark");

}



button?.addEventListener("click",()=>{


document.documentElement.classList.toggle("dark");


const isDark =
document.documentElement.classList.contains("dark");


localStorage.setItem(
"theme",
isDark ? "dark" : "light"
);


});

const progressBar = document.getElementById("progress-bar");


window.addEventListener("scroll",()=>{


const scrollTop = document.documentElement.scrollTop;


const scrollHeight =
document.documentElement.scrollHeight -
document.documentElement.clientHeight;


const progress =
(scrollTop / scrollHeight) * 100;


progressBar.style.width = progress + "%";


});

const backTop = document.getElementById("back-top");


window.addEventListener("scroll",()=>{


if(window.scrollY > 500){

backTop?.classList.add("show");

}else{

backTop?.classList.remove("show");

}


});


backTop?.addEventListener("click",()=>{


window.scrollTo({

top:0,

behavior:"smooth"

});


});

</script>





</body>


</html>





<style>


body {

margin:0;

font-family:
-apple-system,
BlinkMacSystemFont,
"Segoe UI",
sans-serif;

color:#111;

background:#fff;

transition:
background .3s,
color .3s;

}




header {

max-width:1100px;

margin:40px auto;

padding:0 30px;

display:flex;

justify-content:space-between;

align-items:center;

}





.logo a {

font-size:22px;

font-weight:600;

text-decoration:none;

color:inherit;

}





nav a {

margin-left:25px;

text-decoration:none;

color:#666;

position:relative;

transition:0.3s;

}

nav a:hover{

color:#111;

}

nav a[href="/search"]{

padding:8px 14px;

border-radius:20px;

background:#f5f5f5;

}

nav a.active{

color:#111;

font-weight:600;

}

nav a::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:2px;

background:red;

transition:0.3s;

}


nav a:hover::after{

width:100%;

}

#theme-toggle{


margin-left:25px;

border:none;

background:none;

font-size:18px;

cursor:pointer;


}





main {

max-width:900px;

margin:100px auto;

padding:0 20px;

}




footer {

text-align:center;

margin:100px 0 40px;

color:#888;

font-size:14px;

}






/* Dark Mode */


.dark body{

background:#111;

color:#eee;

}



.dark nav a{

color:#aaa;

}

.dark nav a[href="/search"]{

background:#222;

}

.dark .logo a{

color:#eee;

}



.dark article,
.dark .card{

border-color:#333;

}



.dark article p,
.dark .card p{

color:#aaa;

}



.dark .tags span{

background:#222;

color:#aaa;

}



.dark .buttons a:last-child{

background:#333;

color:#eee;

}

@media (max-width:700px){

header{

margin:25px auto;

padding:0 20px;

}


nav a{

margin-left:12px;

font-size:14px;

}


main{

margin:60px auto;

}


.logo a{

font-size:20px;

}

}

#progress-bar{

position:fixed;

top:0;

left:0;

height:2px;

width:0%;

background:#111;

z-index:99999;

transition:width .1s;

}

#back-top{

position:fixed;

right:30px;

bottom:30px;

width:45px;

height:45px;

border-radius:50%;

border:none;

background:#111;

color:white;

font-size:20px;

cursor:pointer;

opacity:0;

visibility:hidden;

transition:0.3s;

}


#back-top.show{

opacity:1;

visibility:visible;

}


#back-top:hover{

transform:translateY(-5px);

}

@media(max-width:768px){


header{

padding:0 20px;

margin:25px auto;

}


nav a{

margin-left:12px;

font-size:14px;

}



main{

margin:60px auto;

padding:0 16px;

}



h1{

font-size:40px;

}



#back-top{

right:20px;

bottom:20px;

}


}

</style>