---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";


export async function getStaticPaths(){

const posts = await getCollection("blog");


return posts.map((post)=>({

params:{
slug:post.id
},

props:{
post
}

}));

}


const {post}=Astro.props;

const { Content } = await render(post);

---


<Layout title={post.data.title} description={post.data.description}>


<main>


<h1>
{post.data.title}
</h1>



<p class="meta">

{post.data.category}

 · 

{post.data.date.toLocaleDateString("zh-CN")}

</p>




{
post.data.cover && (

<img
class="cover"
src={post.data.cover}
alt={post.data.title}
/>

)
}





<div class="tags">


{
post.data.tags?.map((tag)=>(

<span>
#{tag}
</span>

))
}


</div>




<article>

<Content />

</article>


</main>


</Layout>





<style>


main{

max-width:800px;

}



h1{

font-size:48px;

line-height:1.3;

margin-bottom:20px;

}



.meta{

color:#888;

margin-bottom:40px;

}



.cover{

width:100%;

max-height:450px;

object-fit:cover;

border-radius:16px;

margin-bottom:35px;

}



.tags{

margin-bottom:40px;

}



.tags span{

display:inline-block;

margin-right:12px;

font-size:14px;

color:#666;

}



article{

font-size:18px;

line-height:1.9;

}



article h2{

margin-top:50px;

}



article p{

color:#333;

}



</style>