---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
.sort(
(a,b)=>b.data.date.valueOf()-a.data.date.valueOf()
);
---


<Layout title="Blog - Eric Digital Garden">


<main>


<h1>
Blog
</h1>


<p class="intro">
记录 AI、科技和工具探索。
</p>


<div id="search"></div>


<div class="count">

{posts.length} 篇文章

</div>



<div class="posts">


{
posts.map((post)=>(

<article>


{
post.data.cover && (

<img
src={post.data.cover}
alt={post.data.title}
/>

)
}



<a href={`/blog/${post.id}`} class="title">

<h2>
{post.data.title}
</h2>

</a>



<p>
{post.data.description}
</p>



<span>
{post.data.category}
 · 
{post.data.date.toLocaleDateString("zh-CN")}
</span>



<div class="tags">


{
post.data.tags?.map((tag)=>(

<span class="tag">
#{tag}
</span>

))
}


</div>


</article>

))
}


</div>


</main>


</Layout>



<script>
import { PagefindUI } from "@pagefind/default-ui";

new PagefindUI({
  element: "#search",
  showSubResults: true
});
</script>



<style>


main{

max-width:800px;

}



h1{

font-size:56px;

font-weight:700;

margin-bottom:20px;

letter-spacing:-1px;

}



.intro{

font-size:20px;

color:#666;

line-height:1.8;

max-width:650px;

margin-bottom:40px;

}

.count{

display:inline-block;

padding:8px 16px;

background:#f5f5f5;

border-radius:999px;

font-size:14px;

color:#666;

margin-bottom:40px;

}

#search{

margin-bottom:40px;

}


#search input{

width:100%;

padding:14px 18px;

font-size:16px;

border:1px solid #eee;

border-radius:14px;

outline:none;

transition:0.3s;

box-sizing:border-box;

}


#search input:focus{

border-color:#111;

box-shadow:0 0 0 4px rgba(0,0,0,.08);

}



article{

padding:30px;

border:1px solid #eee;

border-radius:20px;

margin-bottom:24px;

transition:0.3s;

}


article:hover{

transform:translateY(-6px);

box-shadow:0 15px 35px rgba(0,0,0,.08);

}



img{

width:100%;

max-height:400px;

object-fit:cover;

border-radius:12px;

margin-bottom:25px;

}



.title{

text-decoration:none;

color:#111;

transition:0.3s;

}


.title:hover{

color:#666;

}



h2{

font-size:28px;

font-weight:500;

}



article p{

color:#555;

}



span{

font-size:14px;

color:#888;

}



.tags{

margin-top:15px;

}



.tag{

display:inline-block;

padding:5px 12px;

margin-right:8px;

border-radius:999px;

background:#f5f5f5;

color:#666;

font-size:14px;

transition:0.3s;

}


.tag:hover{

background:#111;

color:white;

}



</style>