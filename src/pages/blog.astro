---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
.sort(
(a,b)=>b.data.date.valueOf()-a.data.date.valueOf()
);
---


<Layout title="Blog - Eric Digital Garden">


<main>


<h1>
Blog
</h1>


<p class="intro">
记录 AI、科技和工具探索。
</p>


<div id="search"></div>


<p>
文章数量：{posts.length}
</p>



<div class="posts">


{
posts.map((post)=>(

<article>


{
post.data.cover && (

<img
src={post.data.cover}
alt={post.data.title}
/>

)
}



<a href={`/blog/${post.id}`} class="title">

<h2>
{post.data.title}
</h2>

</a>



<p>
{post.data.description}
</p>



<span>
{post.data.category}
 · 
{post.data.date.toLocaleDateString("zh-CN")}
</span>



<div class="tags">


{
post.data.tags?.map((tag)=>(

<span class="tag">
#{tag}
</span>

))
}


</div>


</article>

))
}


</div>


</main>


</Layout>



<script>
import { PagefindUI } from "@pagefind/default-ui";

new PagefindUI({
  element: "#search",
  showSubResults: true
});
</script>



<style>


main{

max-width:800px;

}



h1{

font-size:56px;

}



.intro{

font-size:20px;

color:#666;

margin-bottom:40px;

}



#search{

margin-bottom:40px;

}



article{

padding:30px 0;

border-bottom:1px solid the #eee;

}



img{

width:100%;

max-height:400px;

object-fit:cover;

border-radius:12px;

margin-bottom:25px;

}



.title{

text-decoration:none;

color:#111;

}



h2{

font-size:28px;

font-weight:500;

}



article p{

color:#555;

}



span{

font-size:14px;

color:#888;

}



.tags{

margin-top:15px;

}



.tag{

margin-right:10px;

color:#555;

font-size:14px;

}



</style>