<style>


main{

max-width:900px;

margin:120px auto;

padding:0 20px;

}



h1{

font-size:56px;

}



.intro{

font-size:20px;

color:#666;

margin-bottom:60px;

}



.grid{

display:grid;

gap:25px;

}



.card{

border:1px solid #eee;

border-radius:16px;

padding:30px;

transition:transform .2s;

}



.card:hover{

transform:translateY(-4px);

}



.status{

font-size:14px;

color:#888;

margin-bottom:15px;

}



.card h2{

font-size:28px;

}



.card p{

color:#666;

line-height:1.8;

}



.tags{

margin-top:20px;

}



.tags span{

display:inline-block;

background:#f5f5f5;

padding:6px 12px;

border-radius:20px;

font-size:14px;

margin-right:10px;

color:#555;

}


</style>