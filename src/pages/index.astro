---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";


const posts = await getCollection("blog");


const latestPosts = posts
.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf())
.slice(0,3);

---


<Layout title="Eric Digital Garden">


<main>


<section class="hero">


<p class="subtitle fade-in">
Eric Digital Garden
</p>


<h1 class="fade-in delay-1">
AI · Tech · Tools · Future
</h1>


<p class="intro fade-in delay-2">
探索人工智能、科技工具和个人成长。
记录学习、实践，以及数字时代的新可能。
</p>



<div class="buttons">


<a href="/blog">
阅读文章
</a>


<a href="/projects">
查看项目
</a>


</div>


</section>





<section>


<h2>
Latest Notes
</h2>



<div class="posts">


{
latestPosts.map((post)=>(


<article>


<a href={`/blog/${post.id}`}>

<h3>
{post.data.title}
</h3>

</a>



<p>
{post.data.description}
</p>



<div class="meta">

{post.data.category}

 ·

{post.data.date.toLocaleDateString("zh-CN")}

</div>



<div class="tags">


{
post.data.tags?.map((tag)=>(

<span>
#{tag}
</span>

))
}


</div>



</article>


))
}


</div>


</section>


</main>


</Layout>





<style>


main{

max-width:900px;
margin:120px auto;
padding:0 20px;

}



.hero{

margin-bottom:100px;

}



.subtitle{

font-size:18px;
color:#888;
margin-bottom:20px;

}



h1{

font-size:72px;
line-height:1.15;
letter-spacing:-2px;
margin:0;

}



.intro{

font-size:20px;
color:#666;
line-height:1.9;
max-width:620px;

}



.buttons{

margin-top:40px;

}



.buttons a{

display:inline-block;

padding:14px 28px;

margin-right:15px;

border-radius:12px;

text-decoration:none;

background:#111;

color:white;

font-size:16px;

transition:0.3s;

}

.buttons a{

transition:0.3s;

}


.buttons a:hover{

transform:translateY(-4px);

box-shadow:0 10px 25px rgba(0,0,0,0.12);

}

.buttons a:last-child{

background:#f2f2f2;

color:#111;

}

.buttons a:hover{

transform:translateY(-2px);

opacity:0.85;

}

h2{

font-size:34px;

margin-bottom:40px;

}



article{

padding:30px;

border:1px solid #eee;

border-radius:20px;

margin-bottom:24px;

transition:0.3s;

}


article:hover{

transform:translateY(-6px);

box-shadow:0 15px 35px rgba(0,0,0,.08);

}

article a{

text-decoration:none;

color:#111;

}



h3{

font-size:28px;

line-height:1.4;

margin:0 0 15px;

}



article p{

color:#666;

line-height:1.7;

}



.meta{

color:#888;

font-size:14px;

}



.tags{

margin-top:15px;

}



.tags span{

display:inline-block;

margin-right:8px;

padding:5px 12px;

font-size:13px;

border-radius:999px;

background:#f5f5f5;

color:#666;

}

.fade-in{

opacity:0;

transform:translateY(20px);

animation:fadeUp 0.8s ease forwards;

}


.delay-1{

animation-delay:0.15s;

}


.delay-2{

animation-delay:0.3s;

}


@keyframes fadeUp{

from{

opacity:0;

transform:translateY(20px);

}


to{

opacity:1;

transform:translateY(0);

}

}

</style>