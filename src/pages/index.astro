---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";


const posts = await getCollection("blog");


const latestPosts = posts
.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf())
.slice(0,3);

---


<Layout title="Eric Digital Garden">


<main>


<section class="hero">


<p class="subtitle">
Eric Digital Garden
</p>


<h1>
AI · Tech · Tools · Future
</h1>


<p class="intro">
探索人工智能、科技工具和个人成长。
记录学习、实践，以及数字时代的新可能。
</p>



<div class="buttons">


<a href="/blog">
阅读文章
</a>


<a href="/projects">
查看项目
</a>


</div>


</section>





<section>


<h2>
Latest Notes
</h2>



<div class="posts">


{
latestPosts.map((post)=>(


<article>


<a href={`/blog/${post.id}`}>

<h3>
{post.data.title}
</h3>

</a>



<p>
{post.data.description}
</p>



<div class="meta">

{post.data.category}

 ·

{post.data.date.toLocaleDateString("zh-CN")}

</div>



<div class="tags">


{
post.data.tags?.map((tag)=>(

<span>
#{tag}
</span>

))
}


</div>



</article>


))
}


</div>


</section>


</main>


</Layout>





<style>


main{

max-width:900px;
margin:120px auto;
padding:0 20px;

}



.hero{

margin-bottom:100px;

}



.subtitle{

font-size:18px;
color:#888;
margin-bottom:20px;

}



h1{

font-size:64px;
line-height:1.2;
margin:0;

}



.intro{

font-size:22px;
color:#666;
line-height:1.8;
max-width:650px;

}



.buttons{

margin-top:40px;

}



.buttons a{

display:inline-block;

padding:12px 24px;

margin-right:15px;

border-radius:10px;

text-decoration:none;

background:#111;

color:white;

}



.buttons a:last-child{

background:#eee;

color:#111;

}



h2{

font-size:34px;

margin-bottom:40px;

}



article{

padding:30px;

border:1px solid #eee;

border-radius:16px;

margin-bottom:20px;

}



article a{

text-decoration:none;

color:#111;

}



h3{

font-size:26px;

margin:0 0 15px;

}



article p{

color:#666;

line-height:1.7;

}



.meta{

color:#888;

font-size:14px;

}



.tags{

margin-top:15px;

}



.tags span{

margin-right:12px;

font-size:14px;

color:#666;

}


</style>