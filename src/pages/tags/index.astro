---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";


const posts = await getCollection("blog");


const tags = [...new Set(
  posts.flatMap(post => post.data.tags || [])
)];

---

<Layout title="Tags - Eric">


<main>


<h1>
Tags
</h1>


<p class="intro">
通过标签探索文章。
</p>



<div class="tags">


{
tags.map(tag=>(

<a href={`/tags/${tag}`}>

#{tag}

</a>

))

}


</div>



</main>


</Layout>





<style>


main{

max-width:800px;

margin:120px auto;

padding:0 20px;

}



h1{

font-size:56px;

}



.intro{

color:#666;

font-size:20px;

margin-bottom:50px;

}



.tags{

display:flex;

flex-wrap:wrap;

gap:15px;

}



.tags a{

text-decoration:none;

background:#f5f5f5;

padding:10px 18px;

border-radius:20px;

color:#555;

}



</style>